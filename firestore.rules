rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Orders & bookings
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Shop settings
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
